      "id": "b1a1a111-0000-4000-8000-000000000005",
      "name": "WhatsApp Message (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 400],
      "webhookId": "whatsapp-inbound-message"
    },
    {
      "parameters": {
        "jsCode": "// Meta WhatsApp Cloud API webhook payload shape:\n// { entry: [{ changes: [{ value: { messages: [{ from, text: { body } }] } }] }] }\n// Non-message events (delivery/read receipts, etc.) hit this same webhook\n// and must still be acknowledged with 200, just with no CRM call made.\nconst body = $input.item.json.body ?? $input.item.json;\nconst value = body?.entry?.[0]?.changes?.[0]?.value;\nconst message = value?.messages?.[0];\n\nif (!message) {\n  return [{ json: { hasMessage: false } }];\n}\n\nconst text =\n  message.text?.body ??\n  message.button?.text ??\n  message.interactive?.button_reply?.title ??\n  null;\n\nif (!text) {\n  // Non-text message (image/audio/location/etc.) - not handled by the\n  // catalog-matching pipeline yet, just acknowledge and skip.\n  return [{ json: { hasMessage: false } }];\n}\n\nreturn [{\n  json: {\n    hasMessage: true,\n    phone: message.from,\n    body: text,\n  },\n}];"
      },
      "id": "b1a1a111-0000-4000-8000-000000000006",
      "name": "Extract message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.hasMessage }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1a1a111-0000-4000-8000-000000000007",
      "name": "Has a text message?",
